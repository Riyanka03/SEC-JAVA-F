import java.util.Arrays;

class Solution {
    public int findTheDistanceValue(int[] arr1, int[] arr2, int d) {
        Arrays.sort(arr2);
        int distance = 0;

        for (int num : arr1) {
            if (!hasElementInRange(arr2, num - d, num + d)) {
                distance++;
            }
        }

        return distance;
    }

    private boolean hasElementInRange(int[] arr, int low, int high) {
        int left = 0;
        int right = arr.length - 1;

        while (left <= right) {
            int mid = left + (right - left) / 2;
            if (arr[mid] >= low && arr[mid] <= high) {
                return true;
            } else if (arr[mid] < low) {
                left = mid + 1;
            } else {
                right = mid - 1;
            }
        }

        return false;
    }
}
